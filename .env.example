# u-pal environment template - copy to .env and fill in your values
# this file is tracked for reference. DO NOT commit actual .env with secrets!

# llm provider selection
# options: anthropic (cloud claude), ollama (local)
llm_provider=ollama

# anthropic cloud claude configuration
# get key from https://console.anthropic.com/settings/keys
anthropic_api_key=sk-ant-...
anthropic_model=claude-3-5-haiku-latest
anthropic_temperature=0.4
anthropic_timeout_seconds=60
anthropic_max_tokens=1024

# ollama local llm configuration
# point to your running ollama instance
ollama_url=http://localhost:11434
ollama_model=llama3.1:8b-instruct-q5_K_M
ollama_num_ctx=4096
ollama_timeout_seconds=60

# chroma vector store (rag)
chroma_persist_dir=./chroma_db
chroma_collection=uwtsd_corpus

# embedding model for multilingual support
embedding_model=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# server configuration
port=3001
log_level=info

# cors settings
allowed_origins=*

# rag tuning
rag_top_k=2
rag_max_chars=500
